# PromptShield AI - environment variables

# Provider selection: "mock" or "openai"
LLM_PROVIDER=mock

# OpenAI / OpenAI-compatible configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Storage
DATABASE_URL=sqlite:///data/prompt_logs.db

# Feature toggles
ENABLE_COST_TRACKING=true
ENABLE_MOCK_MODE=true
ENABLE_NEMO_GUARDRAILS=false

# API
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard → API URL.
# Local (no Docker):  http://localhost:8000
# Docker compose:     http://api:8000   (service name from docker-compose.yml)
API_BASE_URL=http://localhost:8000
